+def symbol_universe_hash(symbols: Sequence[Any], main_symbol: Any) -> str:
+    ordered = canonical_symbol_universe(symbols, main_symbol)
+    aliases = {symbol: PROVIDER_ALIASES.get(symbol, {}) for symbol in ordered}
+    return deterministic_hash({"timeframe": TIMEFRAME, "main": ordered[0], "symbols": ordered, "aliases": aliases})
