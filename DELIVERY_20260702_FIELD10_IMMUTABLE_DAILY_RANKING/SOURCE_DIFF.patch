+def _is_crypto(symbol: str) -> bool:
+    return normalize_symbol(symbol).startswith(("BTC", "ETH"))
+
+
+def _expected_trading_hours(start: pd.Timestamp, end: pd.Timestamp, symbol: str) -> pd.DatetimeIndex:
+    expected = pd.date_range(start=start, end=end, freq="h", tz="UTC")
+    if _is_crypto(symbol):
+        return expected
+    # Weekend closure is not treated as a missing market candle. This still
+    # catches gaps during ordinary Monday-Friday trading hours.
+    return expected[expected.dayofweek < 5]
+
