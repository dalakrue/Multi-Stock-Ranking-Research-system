+                      safety_veto AS [Safety Veto],reasons_json AS Reasons,evidence_json AS Evidence
+               FROM field10_daily_safety_event WHERE broker_day=?
+               ORDER BY observed_at_broker_time DESC,symbol""",
+            conn, params=(broker_day,),
+        )
+
